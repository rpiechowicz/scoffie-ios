<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>https://weakly-meals-backend-production.up.railway.app</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>weeklymeals</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>weeklymeals</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Asystent AI: zdjęcie idzie WYŁĄCZNIE do modelu na czas jednej
	     odpowiedzi i nie jest nigdzie zapisywane — ani w telefonie, ani na
	     serwerze. Opis mówi to wprost, bo to jest cała umowa z użytkownikiem. -->
	<key>NSCameraUsageDescription</key>
	<string>Aparat służy do pokazania asystentowi, co masz w lodówce albo na półce. Zdjęcie jest używane tylko do przygotowania jednej odpowiedzi i nigdzie się nie zapisuje.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wybrane zdjęcie trafia do asystenta, żeby mógł zobaczyć, co masz pod ręką. Używamy go tylko do przygotowania jednej odpowiedzi i nigdzie go nie zapisujemy.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Aplikacja odczytuje liczbę kroków ze Zdrowia, aby pokazywać dzienny postęp w Kalendarzu i budować statystyki aktywności.</string>
	<!-- Wymagane przez walidację App Store (kod 90683) dla samego entitlementu
	     HealthKit — aplikacja o zapis nigdy nie prosi, więc ten opis nie ma
	     szansy pojawić się użytkownikowi. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Aplikacja nie zapisuje żadnych danych do Zdrowia — kroki są wyłącznie odczytywane.</string>
</dict>
</plist>
